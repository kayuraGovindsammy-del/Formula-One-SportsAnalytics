rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return isSignedIn() && exists(userPath());
    }

    function currentUser() {
      return get(userPath());
    }

    function isAdmin() {
      return userExists()
        && currentUser().data.role == "ADMIN";
    }

    match /users/{userId} {
      // Users may read their own profile. Admins may read all profiles.
      allow read: if isSignedIn()
        && (request.auth.uid == userId || isAdmin());

      // A new Firebase user may only create their own normal USER profile.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == "USER"
        && request.resource.data.submitterStatus == "none";

      // Normal users may update their own profile without changing UID/role.
      // They may also request submitter access: none -> pending.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && (
          request.resource.data.submitterStatus == resource.data.submitterStatus
          || (
            resource.data.role == "USER"
            && resource.data.submitterStatus == "none"
            && request.resource.data.submitterStatus == "pending"
          )
        );

      // Admins may approve/reject submitter requests and manage roles.
      allow update: if isAdmin();

      // Users may delete their own profile. Admins may delete any profile.
      allow delete: if isSignedIn()
        && (request.auth.uid == userId || isAdmin());
    }

    // Submissions and F1 data are now handled by the Express API + Neon.
    // All other Firestore collections are denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
