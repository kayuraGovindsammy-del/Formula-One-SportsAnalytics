rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function notDeleted(uid) {
      return !exists(/databases/$(database)/documents/accountDeletions/$(uid));
    }

    function activeProfile(uid) {
      return notDeleted(uid)
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid))
          .data.get("deletionPending", false) != true;
    }

    function isAdmin() {
      return signedIn()
        && activeProfile(request.auth.uid)
        && get(userPath()).data.role == "ADMIN";
    }

    function validIdentity(userId) {
      return request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email;
    }

    function validRoleState() {
      return request.resource.data.role in ["USER", "SUBMITTER", "ADMIN"]
        && request.resource.data.submitterStatus in
          ["none", "pending", "approved", "rejected"]
        && (
          request.resource.data.role != "SUBMITTER"
          || request.resource.data.submitterStatus == "approved"
        );
    }

    function ownProfileEdit() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["name", "photoURL"]);
    }

    function ownSubmitterRequest() {
      return resource.data.role == "USER"
        && resource.data.submitterStatus in ["none", "rejected"]
        && request.resource.data.role == "USER"
        && request.resource.data.submitterStatus == "pending"
        && request.resource.data.requestedAt == request.time
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewReason == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "submitterStatus", "requestedAt", "reviewedAt",
          "reviewedBy", "reviewReason"
        ]);
    }

    function adminSubmitterReview(userId) {
      return isAdmin()
        && request.auth.uid != userId
        && resource.data.role == "USER"
        && resource.data.submitterStatus == "pending"
        && request.resource.data.submitterStatus in ["approved", "rejected"]
        && request.resource.data.role == (
          request.resource.data.submitterStatus == "approved"
            ? "SUBMITTER" : "USER"
        )
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewReason is string
        && request.resource.data.reviewReason.size() <= 1000
        && (
          request.resource.data.submitterStatus == "approved"
          || request.resource.data.reviewReason.size() > 0
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "role", "submitterStatus", "reviewedAt",
          "reviewedBy", "reviewReason"
        ]);
    }

    match /accountDeletions/{uid} {
      // Permanent server-owned markers. Only the Admin SDK can access them.
      allow read, write: if false;
    }

    match /users/{userId} {
      // Document reads are available to the owner or an administrator.
      // Collection queries are administrator-only; rules are not filters.
      allow get: if signedIn()
        && ((request.auth.uid == userId && notDeleted(userId)) || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == userId
        && notDeleted(userId)
        && validIdentity(userId)
        && request.resource.data.role == "USER"
        && request.resource.data.submitterStatus == "none"
        && request.resource.data.get("deletionPending", false) == false
        && request.resource.data.keys().hasOnly([
          "uid", "name", "email", "photoURL",
          "role", "submitterStatus", "createdAt"
        ]);

      allow update: if signedIn()
        && request.auth.uid == userId
        && notDeleted(userId)
        && resource.data.get("deletionPending", false) != true
        && request.resource.data.uid == resource.data.uid
        && validRoleState()
        && (ownProfileEdit() || ownSubmitterRequest());

      // Admins can review pending USER requests, not arbitrarily grant ADMIN.
      // Other role changes must be performed by trusted server administration.
      allow update: if isAdmin()
        && notDeleted(userId)
        && resource.data.get("deletionPending", false) != true
        && request.resource.data.get("deletionPending", false) != true
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && validRoleState()
        && adminSubmitterReview(userId);

      // Account deletion must go through the backend.
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
