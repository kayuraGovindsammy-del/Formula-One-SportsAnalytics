{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "description": "F1 Sport Analytics — backend API and derivation engine",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node tools/copy-openapi-spec.mjs",
    "start": "node dist/index.js",
    "ingest": "tsx src/scripts/ingest.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ingest:overtakes": "tsx src/scripts/ingestOvertakes.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "pg": "^8.23.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.11",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@7.6.5": true,
    "@firebase/util@1.15.3": true
  }
}
