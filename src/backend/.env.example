PORT=3001

CORS_ORIGINS=http://localhost:5173,https://f1-sport-analytics-ede0h4cfb3augrhn.francecentral-01.azurewebsites.net

# Aiven for PostgreSQL connection string, copied from "Connection information"
# on the service's Overview page in the Aiven console. Aiven requires TLS, so
# keep sslmode=require.
DATABASE_URL=postgres://avnadmin:YOUR_PASSWORD@YOUR_SERVICE-YOUR_PROJECT.a.aivencloud.com:YOUR_PORT/defaultdb?sslmode=require

# Aiven's CA certificate (the ca.pem download next to the connection string),
# as the PEM file's contents on one line with every newline written as a
# literal \n — config/database.ts turns those back into real newlines before
# handing the value to pg.
#
# Required in deployed environments (Railway). Optional locally: when this is
# unset the backend falls back to reading certs/ca.pem relative to the working
# directory, so a local checkout only needs src/backend/certs/ca.pem and can
# leave this blank. With neither, startup fails with:
#   Database CA certificate is not configured. Set DATABASE_CA_CERT or provide certs/ca.pem.
#
# Leave the placeholder below as-is. This file is committed — real connection
# strings, passwords and certificates belong only in your untracked .env.
DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\nYOUR_AIVEN_CA_CERTIFICATE\n-----END CERTIFICATE-----\n"

FIREBASE_PROJECT_ID=your-firebase-project-id

FIREBASE_CLIENT_EMAIL=your-firebase-service-account-email

FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Chat assistant (POST /api/v1/chat). Optional: with neither key set the
# endpoint answers 503 SERVICE_UNAVAILABLE and the rest of the API is
# unaffected. Groq is tried first; Gemini is the fallback when Groq is rate
# limited, erroring or slow. See docs/third-party-services.md.
#
# Free keys: https://console.groq.com/keys and https://aistudio.google.com/apikey
# The model variables are optional; leave them blank for the defaults
# (openai/gpt-oss-20b and gemini-3.5-flash-lite).
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
