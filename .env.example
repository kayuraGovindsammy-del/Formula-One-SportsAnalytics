# Frontend (Vite) variables only. Nothing here is read by the backend:
# `src/backend/src/index.ts` loads dotenv from its own working directory, so
# the backend reads `src/backend/.env`.
#
# Backend variables — including DATABASE_URL and the Aiven DATABASE_CA_CERT
# described in README.md — live in `src/backend/.env.example`.
# The frontend's own runtime variable (VITE_API_BASE_URL) is in
# `src/frontend/.env.example`.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
